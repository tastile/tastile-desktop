{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              ".claude/hooks/git-guard.mjs"
            ],
            "timeout": 10,
            "statusMessage": "Scanning for destructive commands"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "winui@win-dev-skills": true,
    "microsoft-docs@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "win-dev-skills": {
      "source": {
        "source": "github",
        "repo": "microsoft/win-dev-skills",
        "sparsePaths": [
          ".claude-plugin",
          "plugins/winui"
        ]
      }
    }
  }
}
