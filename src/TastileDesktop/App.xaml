<Application
    x:Class="TastileDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TastileDesktop"
    xmlns:converters="using:TastileDesktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Button.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Override-accent layer: ThemeManager writes here at runtime -->
                    <SolidColorBrush x:Key="OverrideAccentFillBrush" Color="#FF0078D4" />
                    <SolidColorBrush x:Key="OverrideAccentFillSecondaryBrush" Color="#FF1A88DE" />
                    <!-- Intervention-only emergency resources -->
                    <SolidColorBrush x:Key="InterventionScrimBrush" Color="#A6000000" />
                    <SolidColorBrush x:Key="InterventionEmergencyBrush" Color="{ThemeResource SystemFillColorCriticalBrush}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OverrideAccentFillBrush" Color="#FF0078D4" />
                    <SolidColorBrush x:Key="OverrideAccentFillSecondaryBrush" Color="#FF1A88DE" />
                    <SolidColorBrush x:Key="InterventionScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="InterventionEmergencyBrush" Color="{ThemeResource SystemFillColorCriticalBrush}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Layout Tokens -->
            <x:Double x:Key="WindowTitleBarHeight">32</x:Double>
            <CornerRadius x:Key="WindowCardCornerRadius">8</CornerRadius>
            <Thickness x:Key="CardBorderThickness">1</Thickness>
            <x:Double x:Key="SettingRowHeight">48</x:Double>
            <x:Double x:Key="ControlSpacingTight">8</x:Double>
            <x:Double x:Key="ControlSpacingNormal">12</x:Double>
            <x:Double x:Key="ControlSpacingLoose">20</x:Double>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Layout Tokens -->
            <Thickness x:Key="WindowPagePadding">32,24,32,24</Thickness>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <Thickness x:Key="CardBorderThickness">1</Thickness>
            <x:Double x:Key="QuickPanelCornerRadius">8</x:Double>
            <x:Double x:Key="ControlCornerRadius">4</x:Double>

            <!-- Text Styles -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
            </Style>
            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="SectionBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SecondaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="CaptionMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TertiaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="SettingRowLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Card Style -->
            <Style x:Key="WindowCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurface1Brush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <StaticResource x:Key="AccentButtonStyle" ResourceKey="AccentButtonStyle"/>

            <!-- Aliases: removed-by-cea3111 brushes forwarded to System tokens (R14 / F1 fix). -->
            <!-- Spec: docs/superpowers/specs/2026-08-25-tastile-ui-design-system-pass-design.md §Tokens -->
            <StaticResource x:Key="AppBackgroundBrush"           ResourceKey="SolidBackgroundFillColorBaseBrush"/>
            <StaticResource x:Key="AppSurface0Brush"             ResourceKey="LayerFillColorDefaultBrush"/>
            <StaticResource x:Key="AppSurface1Brush"             ResourceKey="LayerFillColorAltBrush"/>
            <StaticResource x:Key="AppSurface2Brush"             ResourceKey="LayerOnAccentAcrylicFillColorDefaultBrush"/>
            <StaticResource x:Key="AppSurfaceElevatedBrush"      ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
            <StaticResource x:Key="AppForegroundBrush"           ResourceKey="TextFillColorPrimaryBrush"/>
            <StaticResource x:Key="AppForegroundMutedBrush"      ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="AppForegroundSubtleBrush"     ResourceKey="TextFillColorTertiaryBrush"/>
            <StaticResource x:Key="AppBorderBrush"               ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="AppBorderStrongBrush"         ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="AccentBrush"                  ResourceKey="AccentFillColorDefaultBrush"/>
            <StaticResource x:Key="AppPrimaryBrush"              ResourceKey="AccentFillColorDefaultBrush"/>
            <StaticResource x:Key="AppPrimaryForegroundBrush"    ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
            <StaticResource x:Key="AppPrimaryHoverBrush"         ResourceKey="AccentFillColorSecondaryBrush"/>
            <StaticResource x:Key="PrimaryForegroundBrush"       ResourceKey="TextFillColorPrimaryBrush"/>
            <StaticResource x:Key="SecondaryForegroundBrush"     ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="TertiaryForegroundBrush"      ResourceKey="TextFillColorTertiaryBrush"/>
            <StaticResource x:Key="QuickPanelBackgroundBrush"    ResourceKey="ControlFillColorTertiaryBrush"/>
            <StaticResource x:Key="QuickPanelBorderBrush"        ResourceKey="ControlStrokeColorDefaultBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
