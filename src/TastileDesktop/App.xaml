<Application
    x:Class="TastileDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TastileDesktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Button.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Quick Panel chrome -->
                    <SolidColorBrush x:Key="QuickPanelBackgroundBrush" Color="#FF242424"/>
                    <SolidColorBrush x:Key="QuickPanelBorderBrush"     Color="#FF373737"/>
                    <!-- Foreground -->
                    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="SecondaryForegroundBrush"  Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="TertiaryForegroundBrush"   Color="#FF6B6B6B"/>
                    <!-- Surfaces -->
                    <SolidColorBrush x:Key="AppBackgroundBrush"        Color="#FF202020"/>
                    <SolidColorBrush x:Key="AppSurface0Brush"          Color="#FF1C1C1C"/>
                    <SolidColorBrush x:Key="AppSurface1Brush"          Color="#FF262626"/>
                    <SolidColorBrush x:Key="AppSurface2Brush"          Color="#FF2F2F2F"/>
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush"   Color="#FF2B2B2B"/>
                    <!-- Foreground aliases -->
                    <SolidColorBrush x:Key="AppForegroundBrush"        Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppForegroundMutedBrush"   Color="#FFD6D6D6"/>
                    <SolidColorBrush x:Key="AppForegroundSubtleBrush"  Color="#FFA6A6A6"/>
                    <!-- Borders -->
                    <SolidColorBrush x:Key="AppBorderBrush"            Color="#FF3D3D3D"/>
                    <SolidColorBrush x:Key="AppBorderStrongBrush"      Color="#FF575757"/>
                    <!-- Interactive -->
                    <SolidColorBrush x:Key="AppInteractiveBrush"       Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppInteractiveHoverBrush"  Color="#FFF4F4F4"/>
                    <SolidColorBrush x:Key="AppInteractiveActiveBrush" Color="#FFE5E5E5"/>
                    <!-- Accent (updated at runtime by ThemeManager) -->
                    <SolidColorBrush x:Key="AccentBrush"               Color="#FF0078D4"/>
                    <SolidColorBrush x:Key="AppPrimaryBrush"           Color="#FF0078D4"/>
                    <SolidColorBrush x:Key="AppPrimaryForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppPrimaryHoverBrush"      Color="#FF1A88DE"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!-- Quick Panel chrome -->
                    <SolidColorBrush x:Key="QuickPanelBackgroundBrush" Color="#FFF9F9F9"/>
                    <SolidColorBrush x:Key="QuickPanelBorderBrush"     Color="#FFE5E5E5"/>
                    <!-- Foreground -->
                    <SolidColorBrush x:Key="PrimaryForegroundBrush"    Color="#FF111111"/>
                    <SolidColorBrush x:Key="SecondaryForegroundBrush"  Color="#FF6A6A6A"/>
                    <SolidColorBrush x:Key="TertiaryForegroundBrush"   Color="#FF9A9A9A"/>
                    <!-- Surfaces -->
                    <SolidColorBrush x:Key="AppBackgroundBrush"        Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="AppSurface0Brush"          Color="#FFF9F9F9"/>
                    <SolidColorBrush x:Key="AppSurface1Brush"          Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="AppSurface2Brush"          Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush"   Color="#FFFFFFFF"/>
                    <!-- Foreground aliases -->
                    <SolidColorBrush x:Key="AppForegroundBrush"        Color="#FF111111"/>
                    <SolidColorBrush x:Key="AppForegroundMutedBrush"   Color="#FF444444"/>
                    <SolidColorBrush x:Key="AppForegroundSubtleBrush"  Color="#FF666666"/>
                    <!-- Borders -->
                    <SolidColorBrush x:Key="AppBorderBrush"            Color="#FFD9D9D9"/>
                    <SolidColorBrush x:Key="AppBorderStrongBrush"      Color="#FFC7C7C7"/>
                    <!-- Interactive -->
                    <SolidColorBrush x:Key="AppInteractiveBrush"       Color="#FF111111"/>
                    <SolidColorBrush x:Key="AppInteractiveHoverBrush"  Color="#FF2A2A2A"/>
                    <SolidColorBrush x:Key="AppInteractiveActiveBrush" Color="#FF3B3B3B"/>
                    <!-- Accent (updated at runtime by ThemeManager) -->
                    <SolidColorBrush x:Key="AccentBrush"               Color="#FF0078D4"/>
                    <SolidColorBrush x:Key="AppPrimaryBrush"           Color="#FF0078D4"/>
                    <SolidColorBrush x:Key="AppPrimaryForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppPrimaryHoverBrush"      Color="#FF1A88DE"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Layout Tokens -->
            <Thickness x:Key="WindowPagePadding">32,24,32,24</Thickness>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <Thickness x:Key="CardBorderThickness">1</Thickness>
            <x:Double x:Key="QuickPanelCornerRadius">8</x:Double>
            <x:Double x:Key="ControlCornerRadius">4</x:Double>

            <!-- Text Styles -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
            </Style>
            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="SectionBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SecondaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="CaptionMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TertiaryForegroundBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="SettingRowLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Card Style -->
            <Style x:Key="WindowCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurface1Brush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <StaticResource x:Key="AccentButtonStyle" ResourceKey="AccentButtonStyle"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
