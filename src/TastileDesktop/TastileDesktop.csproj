<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>TastileDesktop</RootNamespace>
    <Version>0.2.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsSdkPackageVersion>10.0.26100.75</WindowsSdkPackageVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged mode for development; set AppxPackage=true for MSIX release -->
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
    <DaemonRustTarget>x86_64-pc-windows-msvc</DaemonRustTarget>
    <DaemonBinaryPath>..\..\..\tastile-core\target\$(DaemonRustTarget)\release\tastile-daemon.exe</DaemonBinaryPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250310001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Include app icon -->
  <ItemGroup>
    <Content Include="..\..\..\docs\tastile-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="StopRunningTastileProcesses" BeforeTargets="PrepareForBuild">
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p = Get-Process TastileDesktop,tastile-daemon -ErrorAction SilentlyContinue; if ($p) { $p | Stop-Process -Force }; exit 0&quot;"
      ContinueOnError="true" />
  </Target>

  <Target Name="BuildBundledDaemon" BeforeTargets="PrepareForBuild">
    <Message Text="Ensuring latest tastile-daemon release build is bundled..." Importance="high" />
    <Exec
      Command="cargo build -p tastile-daemon --release --target $(DaemonRustTarget)"
      WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\tastile-core" />
  </Target>

  <Target Name="BundleDaemonBinary" BeforeTargets="CopyFilesToOutputDirectory">
    <Message Text="Copying tastile-daemon.exe into desktop output..." Importance="high" />
    <Error
      Text="Bundled tastile-daemon.exe is missing: $(MSBuildThisFileDirectory)$(DaemonBinaryPath)"
      Condition="!Exists('$(MSBuildThisFileDirectory)$(DaemonBinaryPath)')" />
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)$(DaemonBinaryPath)"
      DestinationFiles="$(TargetDir)tastile-daemon.exe"
      SkipUnchangedFiles="false" />
  </Target>

  <Target Name="VerifyBundledDaemon" AfterTargets="CopyFilesToOutputDirectory">
    <Message Text="Verifying bundled tastile-daemon matches latest release build..." Importance="high" />
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$release = [System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(DaemonBinaryPath)'); $bundled = [System.IO.Path]::GetFullPath('$(TargetDir)tastile-daemon.exe'); if (!(Test-Path $release)) { throw ('release tastile-daemon.exe is missing: ' + $release) }; if (!(Test-Path $bundled)) { throw ('bundled tastile-daemon.exe is missing: ' + $bundled) }; $sha = [System.Security.Cryptography.SHA256]::Create(); try { $releaseHash = [System.BitConverter]::ToString($sha.ComputeHash([System.IO.File]::ReadAllBytes($release))).Replace('-', ''); $bundledHash = [System.BitConverter]::ToString($sha.ComputeHash([System.IO.File]::ReadAllBytes($bundled))).Replace('-', ''); } finally { $sha.Dispose() }; if ($releaseHash -ne $bundledHash) { throw ('bundled tastile-daemon.exe is stale: release=' + $releaseHash + ' bundled=' + $bundledHash) }; exit 0&quot;" />
  </Target>
</Project>
