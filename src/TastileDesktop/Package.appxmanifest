<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restricted"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap mp uap10 rescap desktop">

  <Identity
    Name="Tastile.ExecutionControl"
    Publisher="CN=Tastile"
         Version="0.7.0.0" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000000" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Tastile</DisplayName>
    <PublisherDisplayName>Tastile</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Tastile"
        Description="Execution control system"
        BackgroundColor="#FFFFFF"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- tastile:// protocol activation for packaged builds. The unpackaged
             build keeps using the HKCU registry registration in
             ProtocolHandler; packaged builds receive the URI through
             ProtocolActivatedEventArgs instead. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tastile" />
        </uap:Extension>
        <!-- Launch-at-startup for packaged builds. StartupRegistrationService
             uses Windows.ApplicationModel.StartupTask when packaged and falls
             back to the HKCU Run key when unpackaged. -->
        <uap10:Extension Category="windows.startupTask">
          <uap10:StartupTask
            TaskId="TastileStartup"
            Enabled="false"
            DisplayName="Tastile" />
        </uap10:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Full-trust desktop app: required so the packaged WinUI process can
         use registry, named pipes, and other full-trust APIs the same way the
         unpackaged Inno Setup build does. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
