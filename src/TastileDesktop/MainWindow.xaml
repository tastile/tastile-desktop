<Window
    x:Class="TastileDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tastile">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarArea" Margin="12,12,12,0" Padding="14,10" CornerRadius="20" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Tastile" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource AppForegroundMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="AccountButton" Click="OnAccountClick" Padding="12,8" Background="{StaticResource AppSurface2Brush}" Foreground="{StaticResource AppForegroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="AccountTextBlock" Text="Sign In" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24" Spacing="12">
                <TextBlock Text="Open panels" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                <Button Content="Open Execute Window" Click="OnOpenExecuteWindowClick" />
                <Button Content="Open Tiles Window" Click="OnOpenTilesWindowClick" />
                <Button Content="Open Timeline Window" Click="OnOpenTimelineWindowClick" />
                <Button Content="Open Create Tile Window" Click="OnOpenCreateTileWindowClick" />
                <Button Content="Open Settings Window" Click="OnOpenSettingsWindowClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
