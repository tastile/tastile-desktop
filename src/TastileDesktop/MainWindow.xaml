<Window
    x:Class="TastileDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TastileDesktop.ViewModels"
    Title="Tastile">

    <Grid Background="Transparent" Width="892" Height="88">
        <Border
            Background="{ThemeResource QuickPanelBackgroundBrush}"
            BorderBrush="{ThemeResource QuickPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="0">

            <!-- [clock 110] [running *] [next 240] [buttons 152] -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="152" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Countdown + date/time stacked -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock x:Name="StatusText"
                               FontSize="26" FontFamily="Consolas" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryForegroundBrush}"
                               Text="{x:Bind ViewModel.MainCountdownText, Mode=OneWay}" />
                    <TextBlock x:Name="DateText"
                               FontSize="10" FontFamily="Consolas"
                               Foreground="{ThemeResource SecondaryForegroundBrush}"
                               Text="----/--/--" />
                    <TextBlock x:Name="ClockText"
                               FontSize="10" FontFamily="Consolas"
                               Foreground="{ThemeResource SecondaryForegroundBrush}"
                               Text="--:--:--" />
                </StackPanel>

                <!-- Col 1: Running tasks (fills remaining space, priority display) -->
                <Grid Grid.Column="1" Margin="0,8,8,8" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Primary running task - large, always visible -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource AppSurface1Brush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="26" Height="26" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Tag="{x:Bind ViewModel.MainRunningTask.Id, Mode=OneWay}"
                                    Click="OnTaskStatusIconClick">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="{x:Bind ViewModel.MainRunningTask.StatusGlyph, Mode=OneWay}"
                                          FontSize="13" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.MainRunningTask.Title, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource PrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="3" Margin="0,3,0,0" Minimum="0" Maximum="100"
                                             Value="{x:Bind ViewModel.MainRunningTask.ProgressPercent, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Secondary running tasks scroll -->
                    <ScrollViewer x:Name="RunningTasksScrollViewer" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled"
                                  Margin="0,3,0,0" MaxHeight="24">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SecondaryRunningQuickTiles, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:TileListItem">
                                    <Button Tag="{x:Bind Id}" Click="OnRunningTileClick"
                                            Background="{ThemeResource AppSurface1Brush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind StatusGlyph}"
                                                      FontSize="9" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="10"
                                                       Foreground="{ThemeResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Col 2: Next up + candidates (fixed 240px) -->
                <Grid Grid.Column="2" Margin="0,8,8,8" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Primary next tile: whole button opens toast -->
                    <Button Grid.Row="0"
                            Tag="{x:Bind ViewModel.NextUpTileId, Mode=OneWay}"
                            Click="OnNextPrimaryTileClick"
                            Background="{ThemeResource AppSurface1Brush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5"
                            Visibility="{x:Bind ViewModel.NextUpVisibility, Mode=OneWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="{x:Bind ViewModel.NextUp.StatusGlyph, Mode=OneWay}"
                                          FontSize="11" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.NextUpTitle, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource PrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind ViewModel.NextUpStartText, Mode=OneWay}"
                                           FontSize="10" FontFamily="Consolas"
                                           Foreground="{ThemeResource SecondaryForegroundBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.NextUp.TargetDurationText, Mode=OneWay}"
                                           FontSize="10" FontFamily="Consolas"
                                           Foreground="{ThemeResource TertiaryForegroundBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Next candidates scroll: whole button opens toast -->
                    <ScrollViewer x:Name="NextCandidatesScrollViewer" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled"
                                  Margin="0,3,0,0" MaxHeight="24">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NextQuickCandidates, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:TileListItem">
                                    <Button Tag="{x:Bind Id}" Click="OnNextCandidateTileClick"
                                            Background="{ThemeResource AppSurface1Brush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind StatusGlyph}"
                                                          FontSize="9" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                                                <TextBlock Text="{x:Bind Title}" FontSize="10"
                                                           Foreground="{ThemeResource PrimaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind NextStartDisplay}" FontSize="9"
                                                       FontFamily="Consolas"
                                                       Foreground="{ThemeResource SecondaryForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Col 3: 8 buttons ordered: [Refresh|Settings|Pin|Hide] / [Execute|Tiles|Timeline|Create] -->
                <Grid Grid.Column="3" Margin="4,6,8,6" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="RefreshButton" Width="34" Height="28" Click="OnRefreshClick"
                                ToolTipService.ToolTip="Refresh" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE72C;" />
                        </Button>
                        <Button x:Name="SettingsButton" Width="34" Height="28" Click="OnOpenSettingsWindowClick"
                                ToolTipService.ToolTip="Settings" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE713;" />
                        </Button>
                        <Button x:Name="PinButton" Width="34" Height="28" Click="OnPinClick"
                                ToolTipService.ToolTip="Pin window" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE718;" />
                        </Button>
                        <Button x:Name="HideButton" Width="34" Height="28" Click="OnHidePanelClick"
                                ToolTipService.ToolTip="Hide" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                        <Button x:Name="ExecuteButton" Width="34" Height="28" Click="OnOpenExecuteWindowClick"
                                ToolTipService.ToolTip="Execute" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource PrimaryForegroundBrush}" Glyph="&#xE768;" />
                        </Button>
                        <Button x:Name="TilesButton" Width="34" Height="28" Click="OnOpenTilesWindowClick"
                                ToolTipService.ToolTip="Tiles" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource PrimaryForegroundBrush}" Glyph="&#xE8A5;" />
                        </Button>
                        <Button x:Name="TimelineButton" Width="34" Height="28" Click="OnOpenTimelineWindowClick"
                                ToolTipService.ToolTip="Timeline" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource PrimaryForegroundBrush}" Glyph="&#xE787;" />
                        </Button>
                        <Button x:Name="CreateTileButton" Width="34" Height="28" Click="OnOpenCreateTileWindowClick"
                                ToolTipService.ToolTip="Create Tile" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource AccentBrush}" Glyph="&#xE710;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
