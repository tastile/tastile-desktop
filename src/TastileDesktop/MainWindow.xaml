<Window
    x:Class="TastileDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TastileDesktop.ViewModels"
    Title="Tastile">

    <Grid Background="Transparent">
        <Border
            Background="{ThemeResource QuickPanelBackgroundBrush}"
            BorderBrush="{ThemeResource QuickPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="30" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryForegroundBrush}" Text="{x:Bind ViewModel.MainCountdownText, Mode=OneWay}" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="DateText" HorizontalAlignment="Right" TextAlignment="Right" FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource SecondaryForegroundBrush}" Text="----/--/--" />
                        <TextBlock x:Name="ClockText" HorizontalAlignment="Right" TextAlignment="Right" FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource SecondaryForegroundBrush}" Text="--:--:--" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Margin="4,8,8,8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0" MinWidth="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind ViewModel.MainRunningTask.Id, Mode=OneWay}" Click="OnTaskStatusIconClick">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind ViewModel.MainRunningTask.StatusGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MainRunningTask.Title, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.ColumnSpan="2" Margin="0,4,0,0" Height="4" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MainRunningTask.ProgressPercent, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="RunningTasksScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SecondaryRunningQuickTiles, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:TileListItem">
                                    <Button Tag="{x:Bind Id}" Click="OnRunningTileClick" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="4,0,0,0">
                                        <StackPanel Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="16" Height="16" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind Id}" Click="OnTaskStatusIconClick">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind StatusGlyph}" FontSize="9" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                                                </Button>
                                                <TextBlock Text="{x:Bind Title}" FontSize="11" Foreground="{ThemeResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                            </StackPanel>
                                            <ProgressBar Height="3" Margin="0,2,0,0" Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Column="2" Margin="4,8,8,8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Tag="{x:Bind ViewModel.NextUpTileId, Mode=OneWay}" Click="OnNextPrimaryTileClick" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.NextUpVisibility, Mode=OneWay}" Margin="0,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind ViewModel.NextUpTileId, Mode=OneWay}" Click="OnTaskStatusIconClick">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind ViewModel.NextUp.StatusGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.NextUpTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.NextUpStartText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SecondaryForegroundBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer x:Name="NextCandidatesScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NextQuickCandidates, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:TileListItem">
                                    <Button Tag="{x:Bind Id}" Click="OnNextCandidateTileClick" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="4,0,0,0">
                                        <StackPanel Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="16" Height="16" Padding="0" Background="Transparent" BorderThickness="0" Tag="{x:Bind Id}" Click="OnTaskStatusIconClick">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind StatusGlyph}" FontSize="9" Foreground="{ThemeResource PrimaryForegroundBrush}" />
                                                </Button>
                                                <TextBlock Text="{x:Bind Title}" FontSize="11" Foreground="{ThemeResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind NextStartDisplay}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource SecondaryForegroundBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Column="3" Margin="8,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CreateTileButton" Width="36" Height="30" Click="OnOpenCreateTileWindowClick" ToolTipService.ToolTip="Create Tile" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource AccentBrush}" Glyph="&#xE710;" />
                            </Button>
                            <Button x:Name="TilesButton" Width="36" Height="30" Click="OnOpenTilesWindowClick" ToolTipService.ToolTip="Tiles" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource PrimaryForegroundBrush}" Glyph="&#xE8A5;" />
                            </Button>
                            <Button x:Name="TimelineButton" Width="36" Height="30" Click="OnOpenTimelineWindowClick" ToolTipService.ToolTip="Timeline" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource PrimaryForegroundBrush}" Glyph="&#xE787;" />
                            </Button>
                            <Button x:Name="HideButton" Width="36" Height="30" Click="OnHidePanelClick" ToolTipService.ToolTip="Hide" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExecuteButton" Width="36" Height="30" Click="OnOpenExecuteWindowClick" ToolTipService.ToolTip="Execute" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource PrimaryForegroundBrush}" Glyph="&#xE768;" />
                            </Button>
                            <Button x:Name="RefreshButton" Width="36" Height="30" Click="OnRefreshClick" ToolTipService.ToolTip="Refresh" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE72C;" />
                            </Button>
                            <Button x:Name="PinButton" Width="36" Height="30" Click="OnPinClick" ToolTipService.ToolTip="Pin window" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE718;" />
                            </Button>
                            <Button x:Name="SettingsButton" Width="36" Height="30" Click="OnOpenSettingsWindowClick" ToolTipService.ToolTip="Settings" Background="Transparent" BorderThickness="0" Padding="0">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TertiaryForegroundBrush}" Glyph="&#xE713;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="TaskActionPromptToast"
                Canvas.ZIndex="1001"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Padding="10"
                CornerRadius="6"
                Background="{ThemeResource AppSurfaceElevatedBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1">
            <StackPanel MaxWidth="360">
                <TextBlock x:Name="TaskActionPromptTitle" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="TaskActionPromptBody" Foreground="{ThemeResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TaskActionPrimaryButton" Click="OnTaskActionPrimaryClick" Margin="0,0,6,0"/>
                    <Button x:Name="TaskActionSecondaryButton" Click="OnTaskActionSecondaryClick" Margin="0,0,6,0"/>
                    <Button Content="Cancel" Click="OnTaskActionCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
