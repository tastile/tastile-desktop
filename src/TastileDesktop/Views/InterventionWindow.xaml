<Window
    x:Class="TastileDesktop.Views.InterventionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TastileDesktop.Views"
    Title="Tastile - Intervention Required">

    <Grid Background="#CC000000">
        <!-- Semi-transparent overlay that covers the entire screen -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Center content -->
        <Border Grid.Row="1" 
            Background="{StaticResource AppSurfaceElevatedBrush}"
                CornerRadius="12"
                Padding="48"
                MaxWidth="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource AppPrimaryBrush}"
                BorderThickness="2">

            <StackPanel Spacing="24">
                <!-- Icon/Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{StaticResource AppPrimaryBrush}" />
                    <TextBlock Text="Time to Decide" 
                               Style="{StaticResource TitleLargeTextBlockStyle}"
                               Foreground="{StaticResource AppForegroundBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Text="You've been working for 25 minutes."
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource AppForegroundMutedBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <!-- Active tile info (for Work intervention) -->
                <StackPanel x:Name="TileInfoPanel" Spacing="8">
                    <TextBlock x:Name="TileTitleText"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{StaticResource AppForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ElapsedTimeText"
                               Foreground="{StaticResource AppForegroundMutedBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel x:Name="WorkButtons" Spacing="12" Visibility="Collapsed">
                    <Button x:Name="ContinueButton"
                            Content="Continue (25 min)"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnContinue" />
                    <Button x:Name="BreakButton"
                            Content="Take a Break (5 min)"
                            HorizontalAlignment="Stretch"
                            Click="OnTakeBreak" />
                    <Button x:Name="CompleteButton"
                            Content="Complete"
                            HorizontalAlignment="Stretch"
                            Click="OnComplete" />
                </StackPanel>

                <StackPanel x:Name="BreakButtons" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Your break is over!"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button x:Name="EndBreakButton"
                            Content="End Break and Continue"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="OnEndBreak" />
                </StackPanel>

                <StackPanel x:Name="IdleButtons" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="What should you work on?"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    
                    <TextBlock Text="Ready tiles:"
                               HorizontalAlignment="Left" />
                    
                    <ListView x:Name="ReadyTilesList"
                              MaxHeight="200"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnReadyTileClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <Button x:Name="CreateNewButton"
                            Content="Create New Tile..."
                            HorizontalAlignment="Stretch"
                            Click="OnCreateNew" />
                </StackPanel>

                <!-- Hint -->
                <TextBlock Text="This dialog cannot be dismissed. You must take an action."
                           Foreground="{StaticResource AppForegroundSubtleBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           FontStyle="Italic" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
