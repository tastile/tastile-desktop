<Window
    x:Class="TastileDesktop.Views.InterventionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="Intervention"
    Title="Tastile - Intervention Required">

    <Grid Background="#66000000">
        <Border
            Background="{StaticResource AppSurfaceElevatedBrush}"
            CornerRadius="0"
            Padding="28"
            MaxWidth="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="{StaticResource AppBorderStrongBrush}"
            BorderThickness="1">

            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE7BA;" FontSize="40" Foreground="{StaticResource AppPrimaryBrush}" />
                    <TextBlock x:Uid="Intervention_Heading" Text="Intervention required" Style="{StaticResource PageTitleTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    x:Name="MessageText"
                    x:Uid="Intervention_WorkMessage"
                    Text="You've been working for 25 minutes."
                    Style="{StaticResource SectionBodyTextStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />

                <StackPanel x:Name="TileInfoPanel" Spacing="6">
                    <TextBlock x:Name="TileTitleText" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="ElapsedTimeText" Foreground="{StaticResource AppForegroundMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="WorkButtons" Spacing="12" Visibility="Collapsed">
                    <Button x:Name="ContinueButton" x:Uid="Intervention_ContinueButton" Content="Continue (25 min)" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnContinue" />
                    <Button x:Name="BreakButton" x:Uid="Intervention_BreakButton" Content="Take a break (5 min)" HorizontalAlignment="Stretch" Click="OnTakeBreak" />
                    <Button x:Name="CompleteButton" x:Uid="Intervention_CompleteButton" Content="Complete" HorizontalAlignment="Stretch" Click="OnComplete" />
                </StackPanel>

                <StackPanel x:Name="BreakButtons" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="Intervention_BreakOver" Text="Your break is over." Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" />
                    <Button x:Name="EndBreakButton" x:Uid="Intervention_EndBreakButton" Content="End break and continue" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnEndBreak" />
                </StackPanel>

                <StackPanel x:Name="IdleButtons" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="Intervention_ChooseNext" Text="Choose the next tile" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ReadyTilesHintText" x:Uid="Intervention_ReadyTilesHint" Text="Ready tiles" Style="{StaticResource CaptionMutedTextStyle}" />
                    <ListView x:Name="ReadyTilesList" MaxHeight="220" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnReadyTileClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4">
                                    <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding NextAction}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoReadyTilesText" x:Uid="Intervention_NoReadyTiles" Text="No ready tiles. Create a new one to continue." Visibility="Collapsed" Style="{StaticResource SectionBodyTextStyle}" />
                    <Button x:Name="CreateNewButton" x:Uid="Intervention_CreateNewButton" Content="Create new tile" HorizontalAlignment="Stretch" Click="OnCreateNew" />
                </StackPanel>

                <TextBlock x:Uid="Intervention_Footer" Text="This dialog stays on screen until you choose an action." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
