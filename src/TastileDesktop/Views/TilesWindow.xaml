<Window
    x:Class="TastileDesktop.Views.TilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TastileDesktop.ViewModels"
    Title="Tiles">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarArea" Margin="12,12,12,0" Padding="14,10" CornerRadius="20" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tiles" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <RadioButton Content="All" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=TwoWay}" />
                    <RadioButton Content="Ready" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterReady, Mode=TwoWay}" />
                    <RadioButton Content="Started" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterStarted, Mode=TwoWay}" />
                    <RadioButton Content="Done" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterDone, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Border Padding="10" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.TilesListVisibility, Mode=OneWay}">
                <ListView ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTileClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TileListItem">
                            <Grid Padding="10,12" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnTileRightTapped">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AppForegroundBrush}" />
                                    <TextBlock Text="{x:Bind NextActionText}" FontSize="12" Foreground="{StaticResource AppForegroundMutedBrush}" Visibility="{x:Bind HasNextAction}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="10,4" Margin="0,0,8,0" CornerRadius="12" Background="{x:Bind BadgeBackground}">
                                    <TextBlock Text="{x:Bind Lifecycle}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind BadgeForeground}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{x:Bind WorkedText}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Start" Tag="{x:Bind Id}" Click="OnStartTileMenuClick" IsEnabled="{x:Bind IsStartEnabled}" />
                                        <MenuFlyoutItem Text="Complete" Tag="{x:Bind Id}" Click="OnCompleteTileMenuClick" IsEnabled="{x:Bind IsCompleteEnabled}" />
                                        <MenuFlyoutItem Text="Defer" Tag="{x:Bind Id}" Click="OnDeferTileMenuClick" IsEnabled="{x:Bind IsDeferEnabled}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind Id}" Click="OnDeleteTileMenuClick" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Padding="22" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.TilesEmptyVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="No tiles available" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.IdleGuidanceText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
