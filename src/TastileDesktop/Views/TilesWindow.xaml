<Window
    x:Class="TastileDesktop.Views.TilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TastileDesktop.ViewModels"
    Title="Tiles">

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tiles" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource WindowPagePadding}" Spacing="16">

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Ready" Style="{StaticResource CaptionMutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ReadyCount, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Started" Style="{StaticResource CaptionMutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StartedCount, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Done" Style="{StaticResource CaptionMutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="12">
                    <TextBlock Text="Filter" Style="{StaticResource SectionTitleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton Content="All" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=TwoWay}" />
                        <RadioButton Content="Ready" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterReady, Mode=TwoWay}" />
                        <RadioButton Content="Started" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterStarted, Mode=TwoWay}" />
                        <RadioButton Content="Done" GroupName="Filter" IsChecked="{x:Bind ViewModel.IsFilterDone, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <ListView ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTileClick" Visibility="{x:Bind ViewModel.TilesListVisibility, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TileListItem">
                            <Grid Padding="12,14" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnTileRightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                    <Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.StartTileCommand, ElementName=RootGrid}" CommandParameter="{x:Bind Id}" IsEnabled="{x:Bind IsStartEnabled}" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Start">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="12" />
                                    </Button>
                                    <Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.CompleteTileCommand, ElementName=RootGrid}" CommandParameter="{x:Bind Id}" IsEnabled="{x:Bind IsCompleteEnabled}" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Complete">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="12" />
                                    </Button>
                                    <Button Width="28" Height="28" Padding="0" Command="{Binding DataContext.DeferTileCommand, ElementName=RootGrid}" CommandParameter="{x:Bind Id}" IsEnabled="{x:Bind IsDeferEnabled}" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Defer">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind NextActionText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" Visibility="{x:Bind HasNextAction}" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="10,4" Margin="0,0,8,0" CornerRadius="0" Background="{x:Bind BadgeBackground}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Lifecycle}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{x:Bind BadgeForeground}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{x:Bind WorkedText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Start" Tag="{x:Bind Id}" Click="OnStartTileMenuClick" IsEnabled="{x:Bind IsStartEnabled}" />
                                        <MenuFlyoutItem Text="Complete" Tag="{x:Bind Id}" Click="OnCompleteTileMenuClick" IsEnabled="{x:Bind IsCompleteEnabled}" />
                                        <MenuFlyoutItem Text="Defer" Tag="{x:Bind Id}" Click="OnDeferTileMenuClick" IsEnabled="{x:Bind IsDeferEnabled}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind Id}" Click="OnDeleteTileMenuClick" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.TilesEmptyVisibility, Mode=OneWay}">
                    <TextBlock Text="No tiles available" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.IdleGuidanceText, Mode=OneWay}" Style="{StaticResource SectionBodyTextStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
