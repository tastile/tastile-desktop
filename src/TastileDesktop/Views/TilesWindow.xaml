<Window
    x:Class="TastileDesktop.Views.TilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TastileDesktop.Views"
    x:Uid="Tiles"
    Title="Tiles">

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock x:Uid="Tiles_TitleBarHeading" Text="Tiles" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="20">

                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button x:Name="BtnByState" x:Uid="Tiles_ViewByState" Content="状態別" Width="72" Height="32" Click="OnViewByStateClick" Background="Transparent" BorderThickness="1,1,0,1" BorderBrush="{ThemeResource AppBorderBrush}" />
                    <Button x:Name="BtnByGroup" x:Uid="Tiles_ViewByGroup" Content="グループ別" Width="88" Height="32" Click="OnViewByGroupClick" Background="Transparent" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource AppBorderBrush}" />
                    <Button x:Name="BtnByProject" x:Uid="Tiles_ViewByProject" Content="プロジェクト別" Width="104" Height="32" Click="OnViewByProjectClick" Background="Transparent" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource AppBorderBrush}" />
                    <Button x:Name="BtnByTag" x:Uid="Tiles_ViewByTag" Content="タグ別" Width="72" Height="32" Click="OnViewByTagClick" Background="Transparent" BorderThickness="0,1,1,1" BorderBrush="{ThemeResource AppBorderBrush}" />
                </StackPanel>

                <TextBox x:Name="SearchBox" x:Uid="Tiles_SearchPlaceholder" PlaceholderText="検索..." Height="36" TextChanged="OnSearchTextChanged" />

                <StackPanel x:Name="ReadySection" Spacing="12">
                    <Button Click="OnReadyHeaderClick" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Uid="Tiles_Ready" Text="Ready" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="ReadyCount" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding ReadyTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" Padding="0" Tag="{Binding Id}" Click="OnTileStatusClick" Background="Transparent" BorderThickness="0">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="15" Foreground="{Binding StatusBadgeForeground}" />
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource AppForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding TargetDurationText}" Foreground="{StaticResource AppForegroundMutedBrush}" FontFamily="Consolas" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ScheduledTimeDisplay}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Width="28" Height="28" Margin="12,0,0,0" Padding="0" Tag="{Binding Id}" Click="OnTileEditClick" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource AppForegroundMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ReadyMore" Text="" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel x:Name="StartedSection" Spacing="12">
                    <Button Click="OnStartedHeaderClick" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource PrimaryForegroundBrush}" />
                            <TextBlock x:Uid="Tiles_Running" Text="Running" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{StaticResource PrimaryForegroundBrush}" />
                            <TextBlock x:Name="StartedCount" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding StartedTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" Padding="0" Tag="{Binding Id}" Click="OnTileStatusClick" Background="Transparent" BorderThickness="0">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="16" Foreground="{StaticResource PrimaryForegroundBrush}" />
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource AppForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding TargetDurationText}" Foreground="{StaticResource AppForegroundMutedBrush}" FontFamily="Consolas" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ScheduledTimeDisplay}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Width="28" Height="28" Margin="12,0,0,0" Padding="0" Tag="{Binding Id}" Click="OnTileEditClick" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource AppForegroundMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="StartedMore" Text="" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel x:Name="DoneSection" Spacing="12">
                    <Button Click="OnDoneHeaderClick" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AppForegroundMutedBrush}" />
                            <TextBlock x:Uid="Tiles_Done" Text="Done" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" />
                            <TextBlock x:Name="DoneCount" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding DoneTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" Padding="0" Tag="{Binding Id}" Click="OnTileStatusClick" Background="Transparent" BorderThickness="0">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource AppForegroundMutedBrush}" />
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource AppForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding TargetDurationText}" Foreground="{StaticResource AppForegroundMutedBrush}" FontFamily="Consolas" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ScheduledTimeDisplay}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Width="28" Height="28" Margin="12,0,0,0" Padding="0" Tag="{Binding Id}" Click="OnTileEditClick" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource AppForegroundMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DoneMore" Text="" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="12" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
