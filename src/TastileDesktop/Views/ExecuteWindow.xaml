<Window
    x:Class="TastileDesktop.Views.ExecuteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TastileDesktop.ViewModels"
    Title="Execute">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarArea" Margin="12,12,12,0" Padding="14,10" CornerRadius="20" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
            <TextBlock Text="Execute" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1" Margin="12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Padding="18" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.PromptVisibility, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Prompt" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingPromptTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingPromptBody, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingPromptWhy, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PromptActions, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PromptActionButtonViewModel">
                                    <Button Content="{x:Bind Label}" Tag="{x:Bind Id}" Click="OnPromptActionClick" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="18" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IdleVisibility, Mode=OneWay}">
                            <TextBlock Text="Idle" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            <TextBlock Text="No active tile" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.IdleGuidanceText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WorkingVisibility, Mode=OneWay}">
                            <TextBlock Text="WORK" Foreground="{StaticResource AppInteractiveBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTileTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTileNextAction, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WorkElapsedText, Mode=OneWay}" FontSize="18" FontFamily="Consolas" Foreground="{StaticResource AppPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.BreakVisibility, Mode=OneWay}">
                            <TextBlock Text="BREAK" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BreakRemainingText, Mode=OneWay}" FontSize="24" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Start 5m Break" Command="{x:Bind ViewModel.StartBreakCommand}" />
                            <Button Content="Complete" Command="{x:Bind ViewModel.CompleteTileCommand}" />
                            <Button Content="End Break" Command="{x:Bind ViewModel.EndBreakCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="18" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Quick Memo" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                        <TextBox Text="{x:Bind ViewModel.MemoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap" PlaceholderText="{x:Bind ViewModel.MemoPlaceholder, Mode=OneWay}" />
                        <Button Content="Attach Memo" Command="{x:Bind ViewModel.SendMemoCommand}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
