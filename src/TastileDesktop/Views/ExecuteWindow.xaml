<Window
    x:Class="TastileDesktop.Views.ExecuteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TastileDesktop.ViewModels"
    x:Uid="Execute"
    Title="Execute">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock x:Uid="Execute_TitleBarHeading" Text="Execute" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource WindowPagePadding}" Spacing="20" MaxWidth="720">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Execute_Heading" Text="Execution status" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Uid="Execute_Description" Text="Track the current focus block, break timing, and next tile while prompts stay in toast notifications." Style="{StaticResource SectionBodyTextStyle}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.ExecutionStatusLabel, Mode=OneWay}" Style="{StaticResource CaptionMutedTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ExecutionStatusTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ExecutionStatusBody, Mode=OneWay}" Style="{StaticResource SectionBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ExecutionStatusDetail, Mode=OneWay}" Style="{StaticResource CaptionMutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IdleVisibility, Mode=OneWay}">
                        <TextBlock x:Uid="Execute_IdleLabel" Text="Idle" Style="{StaticResource CaptionMutedTextStyle}" />
                        <TextBlock x:Uid="Execute_IdleTitle" Text="No active tile" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.IdleGuidanceText, Mode=OneWay}" Style="{StaticResource SectionBodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WorkingVisibility, Mode=OneWay}">
                        <TextBlock x:Uid="Execute_WorkingLabel" Text="Working now" Style="{StaticResource CaptionMutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTileTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTileNextAction, Mode=OneWay}" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.WorkElapsedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontFamily="Consolas" Foreground="{StaticResource AppPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.BreakVisibility, Mode=OneWay}">
                        <TextBlock x:Uid="Execute_BreakLabel" Text="Break" Style="{StaticResource CaptionMutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BreakRemainingText, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontFamily="Consolas" Foreground="{StaticResource AppForegroundBrush}" />
                    </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Execute_StartBreakButton" Content="Start 5m Break" Command="{x:Bind ViewModel.StartBreakCommand}" />
                            <Button x:Uid="Execute_CompleteButton" Content="Complete" Command="{x:Bind ViewModel.CompleteTileCommand}" />
                            <Button x:Uid="Execute_EndBreakButton" Content="End Break" Command="{x:Bind ViewModel.EndBreakCommand}" />
                        </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Execute_QuickMemo" Text="Quick memo" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBox Text="{x:Bind ViewModel.MemoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap" PlaceholderText="{x:Bind ViewModel.MemoPlaceholder, Mode=OneWay}" />
                        <Button x:Uid="Execute_AttachMemo" Content="Attach Memo" Command="{x:Bind ViewModel.SendMemoCommand}" HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
