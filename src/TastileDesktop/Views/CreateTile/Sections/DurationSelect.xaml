<UserControl
    x:Class="TastileDesktop.Views.CreateTile.Sections.DurationSelect"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="20,6,20,6" Spacing="6">
        <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch" SelectionChanged="OnPresetChanged" />
        <NumberBox x:Name="CustomBox"
                   Visibility="Collapsed"
                   Minimum="1" Maximum="1440"
                   SpinButtonPlacementMode="Inline"
                   ValueChanged="OnCustomValueChanged" />
    </StackPanel>
</UserControl>
