<UserControl
    x:Class="TastileDesktop.Views.CreateTile.CreateTileHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TastileDesktop.Views.CreateTile">
    <Grid Padding="20,10,20,6" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="CloseButton"
                x:Uid="CreateTileHeader_CloseButton"
                Click="OnCloseClick"
                Width="32" Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Center">
            <FontIcon Glyph="&#xE711;" FontSize="14" />
        </Button>

        <TextBox x:Name="TitleInput"
                 x:Uid="CreateTileHeader_TitleInput"
                 Grid.Column="1"
                 BorderThickness="0,0,0,1"
                 Background="Transparent"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Padding="0,4,0,4"
                 VerticalAlignment="Center"
                 TextChanged="OnTitleTextChanged" />

        <Button x:Name="SubmitButton"
                Grid.Column="2"
                MinWidth="92"
                Click="OnSubmitClick"
                Style="{ThemeResource AccentButtonStyle}"
                VerticalAlignment="Center" />
    </Grid>
</UserControl>
