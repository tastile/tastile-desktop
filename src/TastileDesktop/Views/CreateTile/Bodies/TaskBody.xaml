<UserControl
    x:Class="TastileDesktop.Views.CreateTile.Bodies.TaskBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="using:TastileDesktop.Views.CreateTile.Sections">
    <StackPanel Spacing="0">

        <StackPanel Padding="20,6,20,6" Spacing="6">
            <TextBlock x:Name="DurationLabel" x:Uid="CreateTile_TaskBody_DurationLabel" Style="{StaticResource SettingRowLabelTextStyle}" />
            <sections:DurationSelect x:Name="DurationSelect" />
        </StackPanel>

        <Grid Padding="20,6,20,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="SplitAllowButton" x:Uid="CreateTile_TaskBody_SplitAllowButton" Style="{StaticResource SelectorButtonStyle}" Click="OnSplitAllowClick" />
            <ToggleButton x:Name="SplitKeepButton" x:Uid="CreateTile_TaskBody_SplitKeepButton" Grid.Column="1" Style="{StaticResource SelectorButtonStyle}" Click="OnSplitKeepClick" />
        </Grid>

        <Grid Padding="20,6,20,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DueDatePicker" HorizontalAlignment="Stretch" DateChanged="OnDueDateChanged" />
            <TimePicker x:Name="DueTimePicker" Grid.Column="1" TimeChanged="OnDueTimeChanged" />
        </Grid>

        <sections:DetailsAffordanceButton x:Name="DetailsButton" LabelKey="CreateTile.DetailsTaskTitle" />

        <Grid Padding="20,8,20,4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppBorderBrush}">
            <StackPanel Spacing="0">
                <sections:ProjectColorRow x:Name="ProjectRow" />
                <sections:MemoSection x:Name="MemoSection" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
