<UserControl
    x:Class="TastileDesktop.Views.CreateTile.Bodies.RecurringBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="using:TastileDesktop.Views.CreateTile.Sections">
    <StackPanel Spacing="0">

        <Grid Padding="20,6,20,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RepeatLabel" x:Uid="CreateTile_RecurringBody_RepeatLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="RepeatCombo" Grid.Column="1" Width="180" SelectionChanged="OnRepeatChanged" />
        </Grid>

        <StackPanel x:Name="WeekdayPanel" Padding="20,2,20,2" Spacing="6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6" x:Name="WeekdayChipsHost" />
        </StackPanel>

        <Grid x:Name="IntervalPanel" Padding="20,2,20,2" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IntervalLabel" x:Uid="CreateTile_RecurringBody_IntervalLabel" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumberBox x:Name="IntervalValueBox" Minimum="1" Maximum="365" Width="100" SpinButtonPlacementMode="Inline" ValueChanged="OnIntervalValueChanged" />
                <ComboBox x:Name="IntervalUnitCombo" Width="100" SelectionChanged="OnIntervalUnitChanged" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="MonthlyPanel" Padding="20,2,20,2" Spacing="6" Visibility="Collapsed">
            <ComboBox x:Name="MonthlyKindCombo" HorizontalAlignment="Stretch" SelectionChanged="OnMonthlyKindChanged" />
            <NumberBox x:Name="MonthlyDayBox" x:Uid="CreateTile_RecurringBody_MonthlyDayBox" Minimum="1" Maximum="31" SpinButtonPlacementMode="Inline" ValueChanged="OnMonthlyDayChanged" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MonthlyWeekOfMonthCombo" Grid.Column="0" SelectionChanged="OnMonthlyWeekChanged" />
                <ComboBox x:Name="MonthlyWeekdayCombo" Grid.Column="1" SelectionChanged="OnMonthlyWeekdayChanged" />
            </Grid>
        </StackPanel>

        <Grid Padding="20,6,20,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="CreateTile_RecurringBody_TimeModelLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="TimeModelCombo" Grid.Column="1" Width="180" SelectionChanged="OnTimeModelChanged" />
        </Grid>

        <StackPanel x:Name="TimeRowHost" />

        <Grid Padding="20,6,20,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RepeatUntilLabel" x:Uid="CreateTile_RecurringBody_RepeatUntilLabel" VerticalAlignment="Center" />
            <DatePicker x:Name="RepeatUntilDate" Grid.Column="1" />
            <ToggleSwitch x:Name="RepeatUntilToggle" Grid.Column="2" OnContent="" OffContent="" Toggled="OnRepeatUntilToggled" />
        </Grid>

        <StackPanel Padding="20,6,20,6" Spacing="6">
            <TextBlock x:Name="DurationLabel" x:Uid="CreateTile_RecurringBody_DurationLabel" Style="{StaticResource SettingRowLabelTextStyle}" />
            <sections:DurationSelect x:Name="DurationSelect" />
        </StackPanel>

        <sections:DetailsAffordanceButton x:Name="DetailsButton" LabelKey="CreateTile.DetailsRecurringTitle" />

        <Grid Padding="20,8,20,4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppBorderBrush}">
            <StackPanel Spacing="0">
                <sections:ProjectColorRow x:Name="ProjectRow" />
                <sections:MemoSection x:Name="MemoSection" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
