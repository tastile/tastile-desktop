<UserControl
    x:Class="TastileDesktop.Views.CreateTile.Bodies.EventBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="using:TastileDesktop.Views.CreateTile.Sections">
    <StackPanel Spacing="0">

        <sections:DateTimeRow x:Name="StartDateTime"
                              DateChanged="OnStartDateChanged"
                              TimeChanged="OnStartTimeChanged" />
        <sections:DateTimeRow x:Name="EndDateTime"
                              DateChanged="OnEndDateChanged"
                              TimeChanged="OnEndTimeChanged" />

        <Grid Padding="20,6,20,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AllDayLabel" x:Uid="CreateTile_EventBody_AllDayLabel" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="AllDayToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="OnAllDayToggled" />
        </Grid>

        <sections:DetailsAffordanceButton x:Name="DetailsButton" LabelKey="CreateTile.DetailsEventTitle" />

        <Grid Padding="20,8,20,4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppBorderBrush}">
            <StackPanel Spacing="0">
                <sections:ProjectColorRow x:Name="ProjectRow" />
                <sections:MemoSection x:Name="MemoSection" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
