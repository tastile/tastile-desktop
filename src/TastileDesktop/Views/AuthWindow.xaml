<Window
    x:Class="TastileDesktop.Views.AuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sign in to Tastile">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="{StaticResource AppSurface0Brush}">
            <TextBlock Text="Google sign-in" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource WindowPagePadding}">
            <Border Style="{StaticResource WindowCardBorderStyle}" Padding="24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="280">
                <StackPanel Spacing="16">
                    <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{StaticResource AppPrimaryBrush}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Sign in with Google" Style="{StaticResource PageTitleTextStyle}" TextAlignment="Center" />
                        <TextBlock Text="We opened your browser. Complete Google sign-in there, then return here." Style="{StaticResource SectionBodyTextStyle}" TextAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusTextBlock" Text="Waiting for Google authentication..." TextWrapping="Wrap" Foreground="{StaticResource AppForegroundSubtleBrush}" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="OpenBrowserButton" Content="Open browser again" Click="OnOpenBrowserClick" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
