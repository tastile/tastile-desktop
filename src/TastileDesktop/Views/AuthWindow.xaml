<Window
    x:Class="TastileDesktop.Views.AuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sign in to Tastile">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock Text="Authentication" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource WindowPagePadding}">
            <Border Style="{StaticResource WindowCardBorderStyle}" Padding="24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <ProgressRing IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Waiting for authentication" Style="{StaticResource PageTitleTextStyle}" TextAlignment="Center" />
                        <TextBlock Text="Complete the sign-in flow in your browser. This window will close automatically after the daemon confirms the session." Style="{StaticResource SectionBodyTextStyle}" TextAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusTextBlock" Text="" TextWrapping="Wrap" Foreground="{StaticResource AppForegroundMutedBrush}" TextAlignment="Center" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
