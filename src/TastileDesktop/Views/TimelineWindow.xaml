<Window
    x:Class="TastileDesktop.Views.TimelineWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TastileDesktop.ViewModels"
    Title="Timeline">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarArea" Margin="12,12,12,0" Padding="14,10" CornerRadius="20" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
            <TextBlock Text="Timeline" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1" Margin="12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Padding="18" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Next Up" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.NextUpTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.NextUpAction, Mode=OneWay}" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="18" CornerRadius="22" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Today" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TimelineSegments, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelineSegmentViewModel">
                                    <Grid Padding="6,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind TimeText}" Foreground="{StaticResource AppForegroundMutedBrush}" FontFamily="Consolas" />
                                        <Border Grid.Column="1" Padding="10,6" CornerRadius="14" Background="{x:Bind BadgeColor}">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
