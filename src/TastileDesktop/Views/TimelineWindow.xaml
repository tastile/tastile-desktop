<Window
    x:Class="TastileDesktop.Views.TimelineWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TastileDesktop.ViewModels"
    Title="Timeline">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock Text="Timeline" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <Grid x:Name="TimelineRootGrid" Grid.Row="1" Padding="{StaticResource WindowPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ToolbarPanel" Grid.Row="0" Padding="12" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="←" MinWidth="36" />
                    <Button Grid.Column="1" Content="Today" MinWidth="64" />
                    <Button Grid.Column="2" Content="→" MinWidth="36" />

                    <Button Grid.Column="4" Content="Day" />
                    <Button Grid.Column="5" Content="Week" />
                    <Button Grid.Column="6" Content="Month" />
                    <Button Grid.Column="7" Content="Year" />

                    <ComboBox Grid.Column="9" MinWidth="84" />
                    <Button Grid.Column="10" Content="-" MinWidth="32" />
                    <Button Grid.Column="11" Content="+" MinWidth="32" />

                    <TextBlock Grid.Column="12" Text="{Binding TimelineRangeLabel, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource SectionBodyTextStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ScrollViewer x:Name="TimelineScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="OnTimelineWheelChanged" Visibility="{Binding TimelineCanvasVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                        <Grid x:Name="TimelineCanvasHost" Margin="0,4,0,0" Height="{Binding TimelineCanvasHeight, Mode=OneWay}" HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding TimelineHourMarkers, Mode=OneWay}" Height="{Binding TimelineCanvasHeight, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}">
                                            <Grid.RenderTransform>
                                                <TranslateTransform Y="{Binding Top}" />
                                            </Grid.RenderTransform>
                                            <Rectangle Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}" Height="1" Fill="{StaticResource AppBorderBrush}" />
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="10" Margin="4,-14,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding TimelineBlocks, Mode=OneWay}" Height="{Binding TimelineCanvasHeight, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}" Height="{Binding Height}" Padding="10,6" CornerRadius="6" Background="{Binding Fill}" BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                                            </Border.RenderTransform>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Width="28" Height="28" Padding="0" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Command="{Binding StatusCommand}">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding StatusIconGlyph}" Foreground="{Binding StatusForegroundBrush}" FontSize="14" VerticalAlignment="Center" />
                                                </Button>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{Binding ForegroundBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TimeRangeText}" Foreground="{Binding SecondaryForegroundBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding KindLabel}" Foreground="{Binding SecondaryForegroundBrush}" FontSize="11" Visibility="{Binding KindLabelVisibility}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Command="{Binding EditCommand}">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" Foreground="{Binding SecondaryForegroundBrush}" FontSize="13" VerticalAlignment="Center" />
                                                </Button>
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{Binding SecondaryForegroundBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Canvas Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}" Visibility="{Binding TimelineNowVisibility, Mode=OneWay}">
                                <Canvas.RenderTransform>
                                    <TranslateTransform Y="{Binding TimelineNowTop, Mode=OneWay}" />
                                </Canvas.RenderTransform>
                                <Rectangle Canvas.Top="0" Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}" Height="2" Fill="{StaticResource AppPrimaryBrush}" />
                                <Ellipse Canvas.Left="-4" Canvas.Top="-3" Width="8" Height="8" Fill="{StaticResource AppPrimaryBrush}" />
                                <TextBlock Canvas.Top="-14" Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}" TextAlignment="Right" Padding="0,0,4,0" Text="{Binding TimelineNowLabel, Mode=OneWay}" Foreground="{StaticResource AppPrimaryBrush}" FontSize="11" />
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="MonthCalendarHost" Visibility="{Binding MonthCalendarVisibility, Mode=OneWay}" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mon" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="Tue" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Wed" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Grid.Column="3" Text="Thu" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Grid.Column="4" Text="Fri" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Grid.Column="5" Text="Sat" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                        <TextBlock Grid.Column="6" Text="Sun" HorizontalAlignment="Center" Style="{StaticResource SectionBodyTextStyle}" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthCalendarRows, Mode=OneWay}" VerticalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="MonthCell" Margin="0,0,0,8" Padding="8" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Opacity="{Binding CellOpacity}" VerticalAlignment="Stretch">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding DayNumber}" Foreground="{StaticResource AppForegroundBrush}" FontWeight="SemiBold" />
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Entries}">
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,2" Height="24" HorizontalAlignment="Stretch">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="24" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding StatusCommand}">
                                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding StatusIconGlyph}" Foreground="{Binding StatusForegroundBrush}" FontSize="11" />
                                                                        </Button>
                                                                        <TextBlock Grid.Column="1" Margin="0,0,4,0" Text="{Binding Title}" Foreground="{StaticResource AppForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Margin="0,0,2,0" Text="{Binding DurationText}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding DurationVisibility}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Week Timeline View -->
                <ScrollViewer x:Name="WeekTimelineScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="OnTimelineWheelChanged" Visibility="{Binding WeekCalendarVisibility, Mode=OneWay}">
                    <Grid x:Name="WeekTimelineColumnsHost">
                        <Grid.Resources>
                            <Style x:Key="TransparentWeekLaneItemContainerStyle" TargetType="ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekTimelineColumns, Mode=OneWay}" Margin="0,0,0,8" ItemContainerStyle="{StaticResource TransparentWeekLaneItemContainerStyle}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding DataContext.WeekDayColumnWidth, ElementName=WeekTimelineColumnsHost, Mode=OneWay}" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="{Binding DayLabel}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding DayNumber}" Foreground="{StaticResource AppForegroundBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding WeekTimelineHourMarkers, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding ActualWidth, ElementName=WeekTimelineColumnsHost}">
                                            <Grid.RenderTransform>
                                                <TranslateTransform Y="{Binding Top}" />
                                            </Grid.RenderTransform>
                                            <Rectangle Width="{Binding ActualWidth, ElementName=WeekTimelineColumnsHost}" Height="1" Fill="{StaticResource AppBorderBrush}" />
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource AppForegroundMutedBrush}" FontSize="10" Margin="4,-14,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding WeekTimelineColumns, Mode=OneWay}" ItemContainerStyle="{StaticResource TransparentWeekLaneItemContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding DataContext.WeekDayColumnWidth, ElementName=WeekTimelineColumnsHost, Mode=OneWay}" Height="{Binding DataContext.WeekCanvasHeight, ElementName=WeekTimelineColumnsHost, Mode=OneWay}" Background="Transparent">
                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding Width}" Height="{Binding Height}" Padding="10,6" CornerRadius="6" Background="{Binding Fill}" BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform X="{Binding Left}" Y="{Binding Top}" />
                                                            </Border.RenderTransform>
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Width="28" Height="28" Padding="0" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Command="{Binding StatusCommand}">
                                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding StatusIconGlyph}" Foreground="{Binding StatusForegroundBrush}" FontSize="14" VerticalAlignment="Center" />
                                                                </Button>
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" Foreground="{Binding ForegroundBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding TimeRangeText}" Foreground="{Binding SecondaryForegroundBrush}" FontSize="12" />
                                                                    <TextBlock Text="{Binding KindLabel}" Foreground="{Binding SecondaryForegroundBrush}" FontSize="11" Visibility="{Binding KindLabelVisibility}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{Binding SecondaryForegroundBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ItemsControl x:Name="YearCalendarHost" Visibility="{Binding YearCalendarVisibility, Mode=OneWay}" ItemsSource="{Binding YearCalendarRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Months}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Tag="YearMonthCard" Margin="0,0,0,10" Padding="8" Background="{StaticResource AppSurface1Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource AppForegroundBrush}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Tag="YearDayCell" Margin="0,0,0,2" Padding="2" Opacity="{Binding CellOpacity}">
                                                                            <TextBlock Text="{Binding DayNumber}" Style="{StaticResource SectionBodyTextStyle}" HorizontalAlignment="Center" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="LoadingOverlay" Background="{StaticResource AppSurface0Brush}" Opacity="0.86" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing Width="32" Height="32" IsActive="True" Foreground="{StaticResource AppPrimaryBrush}" />
                        <TextBlock Text="Loading calendar..." Foreground="{StaticResource AppForegroundBrush}" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
