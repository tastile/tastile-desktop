<Window
    x:Class="TastileDesktop.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock Text="Settings" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="24" MaxWidth="720">
                <StackPanel Spacing="6">
                    <TextBlock Text="Windows appearance" Style="{ThemeResource TitleLargeTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <TextBlock Text="Tastile follows the appearance and accessibility choices of the current Windows user." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border CornerRadius="0" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="App theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Derived from Windows app appearance." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppThemeSummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="System theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Shell theme used by Windows itself." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SystemThemeSummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="App accent color" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="The accent currently used by Tastile after source selection." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="{x:Bind ViewModel.AccentBrush, Mode=OneWay}" Stroke="{StaticResource AppBorderBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.AccentColorHex, Mode=OneWay}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Windows accent" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Accent color selected in Personalization > Colors." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="{x:Bind ViewModel.WindowsAccentBrush, Mode=OneWay}" Stroke="{StaticResource AppBorderBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.WindowsAccentColorHex, Mode=OneWay}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Windows UI accent" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Accent exposed by the shell UI APIs. Some devices report a different highlight color here." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="{x:Bind ViewModel.UiAccentBrush, Mode=OneWay}" Stroke="{StaticResource AppBorderBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.UiAccentColorHex, Mode=OneWay}" Foreground="{StaticResource AppForegroundMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Transparency effects" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransparencySummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Animations" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AnimationsSummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="High contrast" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HighContrastSummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Taskbar alignment" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaskbarAlignmentSummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12">
                    <TextBlock Text="Accent color" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Accent source" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AccentColorMode, Mode=TwoWay}">
                            <ComboBoxItem Content="Follow Windows accent" Tag="windows-accent" />
                            <ComboBoxItem Content="Follow Windows UI accent" Tag="windows-ui-accent" />
                            <ComboBoxItem Content="Use Tastile default blue" Tag="default" />
                            <ComboBoxItem Content="Manual hex color" Tag="manual" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="Use the Windows accent from Personalization by default, or switch to a manual color at any time." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.ManualAccentVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Manual accent" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.CustomAccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="#0078D4" />
                    </Grid>
                    <TextBlock Text="Accepts #RRGGBB or #AARRGGBB. Invalid values fall back to the Windows accent." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" Visibility="{x:Bind ViewModel.ManualAccentVisibility, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Notifications" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Toast reminder" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.ToastNotifyMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="minutes after work starts" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Force intervention" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.InterventionMinutes, Mode=TwoWay}" Minimum="1" Maximum="120" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="minutes after work starts" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Repeat intervention" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.InterventionRepeatMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="minutes after dismissed" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prompt toast stack" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PromptToastEnabled, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="Show a stacked prompt notification window near the top-center edge of the primary display" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prompt toast max stack" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.PromptToastMaxVisible, Mode=TwoWay}" Minimum="1" Maximum="5" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="Visible cards at once. New prompts stay on top and older ones wait underneath." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prompt toast display" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.PromptToastDisplayMode, Mode=TwoWay}">
                            <ComboBoxItem Content="Primary display" Tag="primary-display" />
                            <ComboBoxItem Content="Display with active window" Tag="active-window-display" />
                            <ComboBoxItem Content="All displays" Tag="all-displays" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="Choose whether the full prompt toast lives on one display or mirrors across all displays." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prompt toast position" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.PromptToastAnchor, Mode=TwoWay}">
                            <ComboBoxItem Content="Top center" Tag="top-center" />
                            <ComboBoxItem Content="Top right" Tag="top-right" />
                            <ComboBoxItem Content="Top left" Tag="top-left" />
                            <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
                            <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="Anchor the main prompt toast to a corner of the chosen display work area." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mirror simplified notifications" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PromptToastMirrorSecondaryDisplays, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="When enabled with All displays, other monitors show a reduced prompt card with only the title and queue count." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Animate prompt toast" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PromptToastAnimate, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="Fade the prompt toast stack in when it appears. Disabled automatically if Windows animations are turned off." Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Button Content="Test prompt toast" Click="OnTestPromptToastClick" HorizontalAlignment="Left" Margin="0,8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Prompt edge overlay" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PromptOverlayEnabled, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="Show a thin accent border around each display when a new prompt appears" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overlay duration" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.PromptOverlayDurationSeconds, Mode=TwoWay}" Minimum="1" Maximum="15" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="seconds" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Suppress in fullscreen apps" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PromptOverlaySuppressFullscreen, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="Skip the overlay when another app occupies the full monitor, such as games or video playback" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Button Content="Test overlay" Click="OnTestPromptOverlayClick" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Breaks" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default break time" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.DefaultBreakMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="minutes" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />

                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Idle prompt after" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.IdlePromptMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" Width="120" />
                    </Grid>
                    <TextBlock Text="minutes" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="System" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Launch at startup" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="Start Tastile when Windows starts" Foreground="{StaticResource AppForegroundSubtleBrush}" FontSize="12" Margin="0,-8,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" Click="OnSaveClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
