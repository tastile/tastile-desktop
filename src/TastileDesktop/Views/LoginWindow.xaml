<Window
    x:Class="TastileDesktop.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TastileDesktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sign in to Tastile">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarArea" Margin="12,12,12,0" Padding="14,10" CornerRadius="20" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
            <TextBlock Text="Sign In" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="48" Spacing="24" MaxWidth="400" HorizontalAlignment="Center">
                
                <!-- Logo and Header -->
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" 
                            Background="{StaticResource AppPrimaryBrush}" 
                            CornerRadius="16"
                            HorizontalAlignment="Center">
                        <TextBlock Text="T" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AppPrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="Tastile" 
                               Style="{StaticResource TitleLargeTextBlockStyle}"
                               Foreground="{StaticResource AppForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in with email" 
                               Foreground="{StaticResource AppForegroundMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error Message -->
                <Border x:Name="ErrorBorder" 
                        Background="{StaticResource AppSurface2Brush}"
                        BorderBrush="#FFDC2626"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorTextBlock" 
                               Foreground="#FFDC2626"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Email/Password Login -->
                <StackPanel Spacing="12">
                    <TextBox x:Name="EmailTextBox" 
                             Header="Email"
                             PlaceholderText="your@email.com"
                             InputScope="EmailSmtpAddress"
                             KeyDown="OnEmailKeyDown"/>
                    
                    <PasswordBox x:Name="PasswordBox" 
                                 Header="Password"
                                 PlaceholderText="Enter your password"
                                 KeyDown="OnPasswordKeyDown"/>
                    
                    <Button x:Name="SignInButton"
                            Content="Sign In" 
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSignInClick"
                            HorizontalAlignment="Stretch"/>
                    
                    <Button x:Name="SignUpButton"
                            Content="Create Account" 
                            Click="OnSignUpClick"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Background="#CC0A0A0A"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Signing in..." 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AppForegroundMutedBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
