<Window
    x:Class="TastileDesktop.Views.IntegrationsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="Integrations"
    Title="Integrations">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock x:Uid="Integrations_TitleBarHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="24" MaxWidth="720">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Integrations_Heading" Style="{ThemeResource TitleLargeTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <TextBlock x:Uid="Integrations_Description" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border CornerRadius="8" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <Border Background="{StaticResource AppSurface0Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="10,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="StatusTextBlock" x:Uid="Integrations_StatusTextBlock" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                        </Border>

                        <TextBlock x:Name="ConnectionHeadlineTextBlock" x:Uid="Integrations_ConnectionHeadlineTextBlock" Style="{StaticResource PageTitleTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConnectionDetailTextBlock" x:Uid="Integrations_ConnectionDetailTextBlock" Style="{StaticResource SectionBodyTextStyle}" TextWrapping="Wrap" />

                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                        <TextBlock x:Uid="Integrations_Calendar" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="TargetCalendarTextBlock" Text="-" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />

                        <TextBlock x:Uid="Integrations_Permissions" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="ReadWriteTextBlock" Text="-" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />

                        <TextBlock x:Name="LastSyncTextBlock" x:Uid="Integrations_LastSyncTextBlock" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        <TextBlock x:Name="SyncHealthTextBlock" x:Uid="Integrations_SyncHealthTextBlock" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />

                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                        <TextBlock x:Uid="Integrations_SyncBehavior" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Uid="Integrations_SyncBehaviorDesc" Style="{StaticResource SectionBodyTextStyle}" TextWrapping="Wrap" />
                        <ComboBox x:Name="SyncModeComboBox" Width="240" SelectedValuePath="Tag">
                            <ComboBoxItem x:Uid="Integrations_SyncModePushOnly" Tag="push_only" />
                            <ComboBoxItem x:Uid="Integrations_SyncModePullOnly" Tag="pull_only" />
                            <ComboBoxItem x:Uid="Integrations_SyncModeBidirectional" Tag="bidirectional" />
                        </ComboBox>
                        <TextBlock x:Name="SyncModeDescriptionTextBlock" Text="-" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />

                        <TextBlock x:Uid="Integrations_TargetCalendar" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBox x:Name="TargetCalendarTextBox" x:Uid="Integrations_TargetCalendarTextBox" Width="240" />
                        <TextBlock x:Uid="Integrations_TargetCalendarHelp" Foreground="{StaticResource AppForegroundSubtleBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SyncPlanTextBlock" Text="-" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />
                        <Button x:Name="SavePolicyButton" x:Uid="Integrations_SavePolicyButton" Click="OnSavePolicyClick" HorizontalAlignment="Stretch" />

                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConnectButton" x:Uid="Integrations_ConnectButton" Click="OnConnectClick" />
                            <Button x:Name="SyncNowButton" x:Uid="Integrations_SyncNowButton" Click="OnSyncNowClick" />
                            <Button x:Name="RefreshButton" x:Uid="Integrations_RefreshButton" Click="OnRefreshClick" />
                            <Button x:Name="DisconnectButton" x:Uid="Integrations_DisconnectButton" Click="OnDisconnectClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorTextBlock" Text="" Foreground="#FFB00020" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
