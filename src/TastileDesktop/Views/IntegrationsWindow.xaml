<Window
    x:Class="TastileDesktop.Views.IntegrationsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Integrations">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Height="32" Padding="16,0,12,0" Background="Transparent">
            <TextBlock Text="Integrations" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{StaticResource AppForegroundBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="24" MaxWidth="720">
                <StackPanel Spacing="6">
                    <TextBlock Text="Google Calendar" Style="{ThemeResource TitleLargeTextBlockStyle}" Foreground="{StaticResource AppForegroundBrush}" />
                    <TextBlock Text="Connect Disconnect Sync now をここから操作できます" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{StaticResource AppForegroundMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border CornerRadius="0" Background="{StaticResource AppSurfaceElevatedBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="StatusTextBlock" Text="Status: loading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" Margin="0,8,0,8" />
                        <TextBlock x:Name="ReadWriteTextBlock" Text="Read/Write: -" Foreground="{StaticResource AppForegroundMutedBrush}" />
                        <TextBlock x:Name="AccountTextBlock" Text="Account: -" Foreground="{StaticResource AppForegroundMutedBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="SyncModeTextBlock" Text="Sync mode: -" Foreground="{StaticResource AppForegroundMutedBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="TargetCalendarTextBlock" Text="Target calendar: -" Foreground="{StaticResource AppForegroundMutedBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="SyncedTextBlock" Text="Last synced: -" Foreground="{StaticResource AppForegroundMutedBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="SyncPlanTextBlock" Text="Sync plan: -" Foreground="{StaticResource AppForegroundMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                            <ComboBox x:Name="SyncModeComboBox" Width="160">
                                <ComboBoxItem Content="push_only" />
                                <ComboBoxItem Content="pull_only" />
                                <ComboBoxItem Content="bidirectional" />
                            </ComboBox>
                            <TextBox x:Name="TargetCalendarTextBox" Width="240" PlaceholderText="calendar id or primary" />
                            <Button x:Name="SavePolicyButton" Content="Save policy" Click="OnSavePolicyClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" Margin="0,0,8,0" />
                            <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnectClick" Margin="0,0,8,0" />
                            <Button x:Name="SyncNowButton" Content="Sync now" Click="OnSyncNowClick" Margin="0,0,8,0" />
                            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
                        </StackPanel>
                        <TextBlock x:Name="ErrorTextBlock" Text="" Foreground="#FF0000" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
