# Tastile Desktop local development environment
# Copy to .env and fill in values.
# DO NOT commit .env
#
# IMPORTANT: production deployment must NEVER bake account IDs, access keys,
# or private deployment identifiers into this file. Replace every
# `<required>` placeholder in a local copy only.

# Cloudflare R2 is the only hosted distribution backend. Versioned release
# objects are immutable; the stable manifest is updated after verification.
CLOUDFLARE_ACCOUNT_ID=<required>
CLOUDFLARE_R2_BUCKET=<required>
CLOUDFLARE_R2_ACCESS_KEY_ID=<required>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<required>

# Public URLs
DOWNLOAD_PUBLIC_BASE_URL=https://download.tastile.app

# Tastile Core local daemon connection
TASTILE_DAEMON_URL=http://localhost:3140

# Cross-repo CI
CORE_REPO_READ_TOKEN=

# --- Required runtime configuration (no prod values hardcoded in source) ---
# Each value below MUST be supplied via the host environment before launch.
# The application throws InvalidOperationException at first use if any are missing.

# Core API base URL (e.g. https://beta.tastile.app for prod, http://127.0.0.1:3140 for local dev)
TASTILE_API_BASE_URL=<required>

# Web account / dashboard URL opened from the tray menu
TASTILE_WEB_ACCOUNT_URL=<required>

# Root URL of the tastile-web deployment hosting BetterAuth endpoints
# (POST /api/auth/sign-in/email, POST /api/auth/sign-up/email,
#  POST /api/auth/sign-out, POST /api/mobile/api-token). Used as the
# base for the native sign-in flow. Falls back to TASTILE_WEB_ACCOUNT_URL
# when unset.
TASTILE_WEB_BASE_URL=<required>

# Desktop auto-update manifest URL. A full .json URL is accepted for the
# stable R2 channel; a host-only value remains legacy-compatible.
TASTILE_DESKTOP_UPDATE_BASE_URL=https://download.tastile.app/channels/stable/desktop.json

# Optional overrides
TASTILE_POLL_IDLE_SECONDS=60
TASTILE_ENABLE_SSE=0
